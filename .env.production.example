PORT=4000

# Frontend API base URL.
# Full-stack deployment on one server: /api
# Static frontend + separate backend: https://your-domain.com/api
VITE_API_BASE_URL=/api

# Admin login
BLOG_ADMIN_USERNAME=admin
BLOG_ADMIN_PASSWORD=replace-with-strong-password

# Dify integration
# Fill these only if you want to enable the AI assistant.
DIFY_API_KEY=replace-with-your-dify-api-key

# Dify service base URL. The server will append /v1 automatically when needed.
# Example:
# DIFY_BASE_URL=http://127.0.0.1
# DIFY_BASE_URL=https://your-dify-domain.com
DIFY_BASE_URL=http://127.0.0.1

# Used to distinguish different users / sessions in Dify.
DIFY_USER_PREFIX=blog-user

# Chat application path. Usually /chat-messages.
DIFY_API_PATH=/chat-messages

# Request timeout and retry configuration
DIFY_TIMEOUT_MS=360000
DIFY_RETRY_COUNT=1
